# ==============================================================================
# SentinelAI X — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (do NOT commit your real '.env' file to Git).
# 2. Replace YOUR_DATABASE_PASSWORD below with your actual Supabase database password.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE DATABASE CONFIGURATION (Supavisor Session Pooler - Port 5432)
# ------------------------------------------------------------------------------
# Region: eu-west-3 (Paris)
# Format: postgresql+psycopg://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres?sslmode=require
#
# Project Reference: yjgekebgaqhkpjesyvgb
# Session Pooler Host: aws-1-eu-west-3.pooler.supabase.com
SUPABASE_DB_URL=postgresql+psycopg://postgres.yjgekebgaqhkpjesyvgb:YOUR_DATABASE_PASSWORD@aws-1-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=require

# Individual Connection Parameters (Alternative / Fallback)
SUPABASE_DB_HOST=aws-1-eu-west-3.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.yjgekebgaqhkpjesyvgb
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_DB_SSLMODE=require

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-this-to-a-secure-random-32-character-string

# Fallback: if Supabase connection fails or is unavailable (e.g. offline use),
# write security events and logs to data/reports/security.log automatically
DATABASE_FALLBACK_FILE_LOGGING=True

# ------------------------------------------------------------------------------
# LOCAL AI RUNTIME SETTINGS (Ollama / Qwen 2.5 3B)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
